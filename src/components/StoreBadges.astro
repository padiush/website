---
import {
    APP_STORE_URL,
    PLAY_STORE_URL,
    useTranslations,
    type Locale,
} from '../i18n';

interface Props {
    locale: Locale;
    class?: string;
}

const { locale, class: className = '' } = Astro.props;
const t = useTranslations(locale);

/*
 * Apple's badge artwork, unaltered, in the visitor's language: black on the
 * light theme and white on the dark one, as Apple's guidelines allow. 40px is
 * the smallest on-screen height they permit.
 *
 * Google's badge in the visitor's language, with only its transparent margin
 * trimmed so it lines up with Apple's. Google makes it in black alone, and
 * asks that it be no smaller than the other stores' badges, so it shares their
 * height.
 */
const badge = (colour: 'black' | 'white') =>
    `/site/badges/app-store-${locale}-${colour}.svg`;
---

<div class={`flex flex-wrap items-center gap-3 ${className}`}>
    <a
        href={APP_STORE_URL}
        class="inline-block rounded-[0.4rem] focus-visible:outline-2 focus-visible:outline-offset-2"
        rel="noopener"
    >
        <img
            src={badge('black')}
            alt={t('store.app_store')}
            width="120"
            height="40"
            class="block h-10 w-auto [[data-theme=padiushdark]_&]:hidden"
        />
        <img
            src={badge('white')}
            alt=""
            aria-hidden="true"
            width="120"
            height="40"
            class="hidden h-10 w-auto [[data-theme=padiushdark]_&]:block"
        />
    </a>
    <a
        href={PLAY_STORE_URL}
        class="inline-block rounded-[0.4rem] focus-visible:outline-2 focus-visible:outline-offset-2"
        rel="noopener"
    >
        <img
            src={`/site/badges/google-play-${locale}.png`}
            alt={t('store.google_play')}
            width="135"
            height="40"
            class="block h-10 w-auto max-w-none"
        />
    </a>
</div>
