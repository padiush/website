---
import { useTranslations, type Locale } from '../i18n';
import Icon from './Icon.astro';

interface Props {
    locale: Locale;
}

const t = useTranslations(Astro.props.locale);
---

{/*
    The field app's Entrevistas tab, drawn in markup so it follows the theme
    and the page's language. It mirrors the app's layout: a green header with
    the last sync, two action tiles across its edge, the projects below and a
    floating tab bar.
*/}
<div
    class="border-base-300 bg-base-200 relative mx-auto w-full max-w-[17.5rem] overflow-hidden rounded-[2.25rem] border-8 shadow-xl"
    aria-hidden="true"
>
    <div class="bg-primary text-primary-content rounded-b-[1.75rem] px-5 pt-7 pb-14">
        <p class="text-xl font-extrabold">{t('home.capture_device_title')}</p>
        <p class="text-primary-content/75 mt-1 flex items-center gap-1.5 text-[0.6875rem]">
            <Icon name="cloudArrowUp" class="h-3 w-3" />
            {t('home.capture_device_synced')}
        </p>
    </div>

    <div class="-mt-10 grid grid-cols-2 gap-2.5 px-4">
        {[
            { icon: 'clipboardList', label: t('home.capture_device_new') },
            { icon: 'leaf', label: t('home.capture_device_record') },
        ].map((tile) => (
            <div class="bg-base-100 border-base-300 flex min-h-24 flex-col justify-between gap-3 rounded-2xl border p-3 shadow-md">
                <span class="bg-primary text-primary-content flex h-8 w-8 items-center justify-center rounded-[0.6rem]">
                    <Icon name={tile.icon as 'leaf'} class="h-4 w-4" />
                </span>
                <span class="text-[0.75rem] leading-tight font-extrabold">
                    {tile.label}
                </span>
            </div>
        ))}
    </div>

    <div class="space-y-2.5 px-4 pt-4 pb-20">
        <div class="bg-base-100 border-base-300 rounded-2xl border p-3">
            <p class="text-[0.8125rem] leading-snug font-bold">
                {t('home.capture_device_project')}
            </p>
            <div class="mt-2 flex flex-wrap items-center gap-1.5">
                <span class="text-base-content/65 text-[0.6875rem]">
                    {t('home.capture_device_interviews')}
                </span>
                <span class="bg-warning/15 text-base-content/80 rounded-full px-2 py-0.5 text-[0.625rem] font-semibold">
                    {t('home.capture_device_pending')}
                </span>
            </div>
        </div>
        <div class="bg-base-100 border-base-300 rounded-2xl border p-3 opacity-60">
            <div class="bg-base-content/15 h-2.5 w-3/4 rounded-full"></div>
            <div class="bg-base-content/10 mt-2.5 h-2 w-1/3 rounded-full"></div>
        </div>
    </div>

    <div class="bg-base-100 border-base-300 absolute inset-x-4 bottom-4 flex items-center justify-around rounded-full border py-2.5 shadow-lg">
        <span class="bg-primary text-primary-content flex h-8 w-12 items-center justify-center rounded-full">
            <Icon name="clipboardList" class="h-4 w-4" />
        </span>
        <span class="text-base-content/55 flex h-8 w-12 items-center justify-center">
            <Icon name="leaf" class="h-4 w-4" />
        </span>
        <span class="text-base-content/55 flex h-8 w-12 items-center justify-center">
            <Icon name="cloudArrowUp" class="h-4 w-4" />
        </span>
    </div>
</div>
