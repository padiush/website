---
import Icon from './Icon.astro';

interface Props {
    id?: string;
    kicker: string;
    title: string;
    description: string;
    points: string[];
    /** Puts the visual on the left on wide screens. */
    reversed?: boolean;
    /** Sets the section on the tinted background. */
    tinted?: boolean;
}

const {
    id,
    kicker,
    title,
    description,
    points,
    reversed = false,
    tinted = false,
} = Astro.props;
---

<section id={id} class:list={['scroll-mt-20', { 'bg-base-200': tinted }]}>
    <div class="mx-auto grid max-w-7xl items-center gap-10 px-6 py-16 md:py-24 lg:grid-cols-2 lg:gap-16">
        <div class:list={[{ 'lg:order-2': reversed }]}>
            <p class="text-primary text-xs font-semibold tracking-[0.18em] uppercase">
                {kicker}
            </p>
            <h2 class="mt-3 text-3xl font-bold text-balance md:text-4xl">
                {title}
            </h2>
            <p class="text-base-content/70 mt-4 text-lg">{description}</p>
            <ul class="mt-6 space-y-3">
                {points.map((point) => (
                    <li class="flex gap-3">
                        <Icon name="check" class="text-primary mt-1 h-4 w-4" />
                        <span class="text-base-content/80">{point}</span>
                    </li>
                ))}
            </ul>
            <slot name="extra" />
        </div>
        {/* min-w-0 lets the column shrink below the visual's natural width. */}
        <div class:list={['min-w-0', { 'lg:order-1': reversed }]}>
            <slot />
        </div>
    </div>
</section>
