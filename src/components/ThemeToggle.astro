---
import { useTranslations, type Locale } from '../i18n';
import Icon from './Icon.astro';

interface Props {
    locale: Locale;
}

const t = useTranslations(Astro.props.locale);
---

{/*
    Both icons and both labels are rendered; the theme on <html> decides which
    one shows, so the button is right before any script runs.
*/}
<button
    type="button"
    class="btn btn-ghost btn-square"
    data-theme-toggle
    data-label-light={t('theme.switch_to_light')}
    data-label-dark={t('theme.switch_to_dark')}
    aria-label={t('theme.switch_to_dark')}
    title={t('theme.switch_to_dark')}
>
    {/* The spans carry the visibility, since the icon sets its own display. */}
    <span class="contents [[data-theme=padiushdark]_&]:hidden">
        <Icon name="moon" class="h-5 w-5" />
    </span>
    <span class="hidden [[data-theme=padiushdark]_&]:contents">
        <Icon name="sun" class="h-5 w-5" />
    </span>
</button>

<script>
    // Same key and values as the platform's ThemeToggle, so the choice made
    // here holds after signing in, and the other way round.
    const STORAGE_KEY = 'theme';
    const DARK = 'padiushdark';
    const LIGHT = 'padiushlight';

    document
        .querySelectorAll<HTMLButtonElement>('[data-theme-toggle]')
        .forEach((button) => {
            const label = () => {
                const dark = document.documentElement.dataset.theme === DARK;
                const text = dark
                    ? button.dataset.labelLight
                    : button.dataset.labelDark;
                button.setAttribute('aria-label', text ?? '');
                button.title = text ?? '';
            };

            label();

            button.addEventListener('click', () => {
                const next =
                    document.documentElement.dataset.theme === DARK
                        ? LIGHT
                        : DARK;
                document.documentElement.dataset.theme = next;
                try {
                    localStorage.setItem(STORAGE_KEY, next);
                } catch {
                    // Private browsing can refuse storage; the switch still
                    // applies to this page.
                }
                label();
            });
        });
</script>
